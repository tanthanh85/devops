flowchart LR
  CHANGE[Commit and tests] --> ART[Artifact digest]
  ART --> APPROVE{Evidence approved?}
  APPROVE -->|yes| DEPLOY[Deploy and observe]
  APPROVE -->|no| CHANGE
  DEPLOY --> RESULT[Runtime evidence]

  classDef source fill:#e8f1fb,stroke:#1769aa,color:#0b2540,stroke-width:2px;
  classDef action fill:#e5f7f4,stroke:#087f6d,color:#063a33,stroke-width:2px;
  classDef decision fill:#fff4d6,stroke:#b66a00,color:#5c3500,stroke-width:2px;
  classDef blocked fill:#fde8e7,stroke:#c43c35,color:#5b1714,stroke-width:2px;
  class CHANGE,ART source;
  class DEPLOY,RESULT action;
  class APPROVE decision;
