  classDef boundary fill:#fff7e6,stroke:#d97706,color:#7c2d12,stroke-width:2px;
  classDef protected fill:#e5f7f4,stroke:#087f6d,color:#063a33,stroke-width:2px;
  classDef blocked fill:#fdecec,stroke:#c62828,color:#681414,stroke-width:2px;
  class U,API,Q,DB service;
  class W boundary;
  class FW,R1,R2,C protected;
