FROM hashicorp/terraform:1.14
RUN apk add --no-cache python3 py3-pip openssh-client busybox-extras \
    && python3 -m pip install --break-system-packages --no-cache-dir hvac==2.3.0 requests==2.32.5
WORKDIR /workspace
COPY automation/common.py /workspace/automation/common.py
COPY ci/audit.py ci/render-cml-inputs.py /workspace/ci/
ENTRYPOINT []
