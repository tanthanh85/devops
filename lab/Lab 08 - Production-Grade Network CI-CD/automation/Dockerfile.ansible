FROM python:3.12-slim
WORKDIR /workspace
RUN groupadd --system automation && useradd --system --gid automation automation
COPY automation/requirements-ansible.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && ansible-galaxy collection install cisco.ios:11.3.0 ansible.netcommon:8.2.0 ansible.utils:6.0.0
COPY --chown=automation:automation automation/common.py ansible/inventory_from_vault.py /workspace/
COPY --chown=automation:automation ansible/ansible.cfg ansible/deploy_loopback.yml /workspace/
COPY --chown=automation:automation ansible/callback_plugins /workspace/callback_plugins
COPY --chown=automation:automation ci/audit.py /workspace/audit.py
USER automation
ENV ANSIBLE_CONFIG=/workspace/ansible.cfg
CMD ["ansible-playbook", "-i", "inventory_from_vault.py", "deploy_loopback.yml"]
